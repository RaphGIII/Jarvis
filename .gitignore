# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated test/benchmark artifacts (Jarvis)
Jarvis/.pytest_tmp/
Jarvis/.agent_tmp/
pytest-current/
pytest-temp/
pytest-v03-final/

# OS / editor cruft
.DS_Store
*.swp

# Tuned on each machine; not portable between hosts.
Jarvis/config/resources.json
Jarvis/.pytest_basetemp/

# Speech stack: large binaries, installed per machine rather than committed.
# The virtualenv keeps ctranslate2/onnxruntime out of the system Python, and
# models are downloaded on setup (see JARVIS_USER_GUIDE.md).
Jarvis/.venv-speech/
Jarvis/data/models/
Jarvis/data/voices/*.onnx
Jarvis/data/voices/*.onnx.json
Jarvis/data/voices/*.wav

# Stockfish: a 65MB engine binary, downloaded per machine like the models.
Jarvis/data/tools/

# Live runtime state: projects, capabilities, audit logs, the knowledge graph.
# Evidence worth keeping is copied into evidence/ deliberately rather than
# tracked here, where it would churn on every run.
Jarvis/data/jarvis/

# ZEUS.exe build output
dist/
build/
